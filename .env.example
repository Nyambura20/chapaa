# Africa's Talking sandbox. Leave the key empty to run the local simulator.
AT_USERNAME=sandbox
AT_API_KEY=
# Leave the sender id empty in the sandbox. A custom sender is rejected there.
AT_SENDER_ID=
AT_VOICE_PHONE_NUMBER=+254711082000

# Public URL of this API (ngrok to port 8000), used as the SMS and voice callback host.
SERVER_BASE_URL=http://127.0.0.1:8000

# Optional. Unset uses the local SQLite file chapaa_guard.db.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chapaa_guard

# Optional. The spam checker still returns a verdict when the Gemini key is empty.
# A model can only raise the verdict. It cannot call a message safe.
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# SAFE_BROWSING_API_KEY=
# VIRUSTOTAL_API_KEY=
