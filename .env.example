# Africa's Talking sandbox. Leave the key empty to run the local simulator.
AT_USERNAME=sandbox
AT_API_KEY=
# Leave the sender id empty in the sandbox. A custom sender is rejected there.
AT_SENDER_ID=
AT_VOICE_PHONE_NUMBER=+254711082000

# For Railway: This will be auto-injected by Railway's PostgreSQL plugin
# For local dev: Create a PostgreSQL database and set this
# DATABASE_URL=postgresql://user:password@localhost:5432/chapaa_guard

# Public URL of this API (Railway domain), used as the SMS and voice callback host.
# For local dev: http://127.0.0.1:8000
# For Railway: https://your-app-name.up.railway.app
SERVER_BASE_URL=http://127.0.0.1:8000

# Optional. Unset uses PostgreSQL via DATABASE_URL.
# For local development only, to use SQLite: sqlite+aiosqlite:///./chapaa_guard.db

# Optional. The spam checker still returns a verdict when the Gemini key is empty.
# A model can only raise the verdict. It cannot call a message safe.
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# SAFE_BROWSING_API_KEY=
# VIRUSTOTAL_API_KEY=

